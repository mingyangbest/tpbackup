# 复制成 .env 才生效：
#   cp .env.example .env
# 每项都可以不写——不写就用 docker-compose.yml 里的默认值。

# ── Web 登录 ──
TP_USER=admin
# 改成你自己的密码。默认的 tpbackup 只是让你先看到界面
TP_PASS=tpbackup

# ── 要备份的宿主机目录 ──
# 填一个绝对路径，它会出现在容器里的 /data。
# 例如飞牛 /vol1/photo、群晖 /volume1/photo、普通 Linux /home/me/photos
BACKUP_DIR=/vol1/photo

# ── 界面能浏览的范围（容器内路径）──
# 默认 /data 就够用。若你把整块盘挂进来（如 /vol1:/vol1），这里要跟着填 /vol1
TP_ALLOWED_ROOTS=/data

# ── 端口 ──
# 8088 被占用时改这里
TP_PORT=8088

# ── 镜像（一般不用动）──
# 想钉住某个版本、或换成自己构建的镜像，就取消注释改这里
# IMAGE_REF=ghcr.io/mingyangbest/tpbackup:v0.2.2
